{
	email info@zermae.com
	auto_https off
	default_sni zermae.com
	fallback_sni zermae.com
	servers {
		protocols h1 h2
	}
}

# HTTP serves the app directly. Hostinger's network path breaks guest TLS on
# :443 (edge answers with TLS alert even when nothing listens in the VM).
# Put Cloudflare in front (orange cloud + SSL Flexible) so visitors get HTTPS
# while origin stays on :80 until Hostinger fixes 443 passthrough.
http://zermae.com, http://www.zermae.com {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	reverse_proxy 127.0.0.1:3000
}

# Local / future direct HTTPS (works on 127.0.0.1; public :443 may still be broken)
zermae.com, www.zermae.com {
	tls /etc/letsencrypt/live/zermae.com/fullchain.pem /etc/letsencrypt/live/zermae.com/privkey.pem

	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	reverse_proxy 127.0.0.1:3000
}
