{
	email info@zermae.com
	auto_https off
	# If SNI is missing/stripped on the public path, Caddy otherwise
	# looks up a cert for the local IP (72.61.119.3) and aborts TLS.
	default_sni zermae.com
	fallback_sni zermae.com
	debug
	servers {
		protocols h1 h2
	}
}

http://zermae.com, http://www.zermae.com {
	redir https://{host}{uri} permanent
}

zermae.com, www.zermae.com {
	tls /etc/letsencrypt/live/zermae.com/fullchain.pem /etc/letsencrypt/live/zermae.com/privkey.pem

	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	# Host-network Caddy cannot resolve Compose DNS names
	reverse_proxy 127.0.0.1:3000
}

