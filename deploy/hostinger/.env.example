# Copy to /var/www/zermae/.env on the Hostinger VPS (never commit real secrets).

NODE_ENV=production
APP_URL=https://zermae.com
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api/v1
API_URL=http://api:5000

POSTGRES_DB=zermae
POSTGRES_USER=zermae
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql://zermae:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/zermae
DATABASE_MIGRATE_URL=postgresql://zermae:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/zermae
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

HMAC_SIGNING_SECRET=CHANGE_ME_64_CHAR_HMAC_SIGNING_SECRET_VALUE_NOT_A_REAL_SECRET
SESSION_SECRET=CHANGE_ME_64_CHAR_SESSION_SECRET_VALUE_NOT_A_REAL_SECRET_XX
SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=600
HMAC_TIMESTAMP_WINDOW_SECONDS=300

RATE_LIMIT_CAPACITY=400
RATE_LIMIT_REFILL_PER_SECOND=2

CORS_ORIGIN=https://zermae.com,https://www.zermae.com
SUPPORT_EMAIL=info@zermae.com
EMAIL_FROM=Zermae <info@zermae.com>

# Google Workspace SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@zermae.com
SMTP_PASS=CHANGE_ME_GOOGLE_APP_PASSWORD

WHATSAPP_PROVIDER=auto
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads
STORAGE_PROVIDER=local

SEED_ADMIN_EMAIL=admin@zermae.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_8CHARS
SEED_ADMIN_NAME=Zermae Admin
