{
	email info@zermae.com
	# Avoid global HTTP→HTTPS until ACME can answer on plain HTTP.
	auto_https disable_redirects
}

zermae.com, www.zermae.com {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Redirect browsers to HTTPS, but never ACME challenge paths.
	@httpNotAcme {
		protocol http
		not path /.well-known/acme-challenge/*
	}
	redir @httpNotAcme https://{host}{uri} permanent

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	reverse_proxy web:3000
}
