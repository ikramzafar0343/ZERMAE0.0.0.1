{
	email info@zermae.com
	auto_https disable_redirects
}

zermae.com, www.zermae.com {
	tls {
		issuer acme {
			# Prefer plain HTTP challenge; TLS-ALPN fails before any cert exists.
			disable_tlsalpn_challenge
		}
	}

	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	reverse_proxy web:3000
}
